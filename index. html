        .project-card:hover {
            transform: translateY(-6px);
            border-color: var(--border-hover);
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
        }

        .project-art {
            position: absolute;
            inset: 0;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            padding-top: 32px;
            overflow: hidden;
            background: radial-gradient(circle at 50% 30%, var(--gradient-glow), transparent 70%);

        .project-card:hover .project-icon {
            transform: scale(1.1) rotate(-6deg);
            color: #ffffff;
            background: var(--gradient);
            box-shadow: 0 10px 30px var(--gradient-glow);
        }

        .project-info {
            position: relative;
            z-index: 2;
        }

        .project-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 8px;
        }

        .project-tag {
            padding: 3px 9px;
            border-radius: 50px;
            background: rgba(255, 255, 255, 0.06);
            color: var(--accent);
            font-size: 0.68rem;
            font-weight: 700;
        }

        .project-info h3 {
            font-size: 1.15rem;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .project-info p {
            color: #aab6c7;
            font-size: 0.78rem;
            line-height: 1.5;
        }

        .project-overlay {
            position: absolute;
            inset: 0;
            z-index: 5;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 14px;
            background: rgba(2, 6, 23, 0.85);
            backdrop-filter: blur(8px);
            opacity: 0;
            transition: var(--transition);
        }

        .project-card:hover .project-overlay { opacity: 1; }

        .project-action {
            width: 52px;
            height: 52px;
            display: grid;
            place-items: center;
            color: #ffffff;
            border: 1px solid var(--border);
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.08);
            font-size: 1.1rem;
            transition: var(--transition);
        }

        .project-action:hover {
            transform: translateY(-4px) scale(1.05);
            background: var(--gradient);
            border-color: transparent;
            box-shadow: 0 8px 20px var(--gradient-glow);
        }

        /* Social */
        .social-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        .social-card {
            min-height: 155px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            transition: var(--transition);
            padding: 20px;
        }

        .social-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 20px 45px rgba(0, 0, 0, 0.35);
            border-color: rgba(255, 255, 255, 0.2);
        }

        .social-icon {
            width: 56px;
            height: 56px;
            display: grid;
            place-items: center;
            border-radius: 18px;
            color: #ffffff;
            font-size: 1.5rem;
            transition: var(--transition);
        }

        .social-card:hover .social-icon { transform: scale(1.12) rotate(6deg); }

        .facebook .social-icon { background: #1877f2; box-shadow: 0 8px 20px rgba(24, 119, 242, 0.3); }
        .tiktok .social-icon { background: #000000; border: 1px solid rgba(255, 255, 255, 0.2); box-shadow: 0 8px 20px rgba(255, 255, 255, 0.15); }
        .instagram .social-icon { background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045); box-shadow: 0 8px 20px rgba(253, 29, 29, 0.3); }
        .youtube .social-icon { background: #ff0000; box-shadow: 0 8px 20px rgba(255, 0, 0, 0.3); }

        .social-card strong { font-size: 0.95rem; font-weight: 800; }
        .social-card span { color: var(--muted); font-size: 0.74rem; }

        /* Contact */
        .contact-wrapper {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            gap: 28px;
            align-items: stretch;
        }

        .contact-info, .contact-form {
            padding: 34px;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            background: var(--card-bg);
            backdrop-filter: blur(20px);
            box-shadow: var(--shadow);
            transition: var(--transition);
        }

        .contact-info h3 {
            font-size: 1.45rem;
            font-weight: 800;
            margin-bottom: 10px;
        }

        .contact-info > p {
            color: var(--muted);
            line-height: 1.9;
            font-size: 0.88rem;
            margin-bottom: 25px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 14px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .contact-item:last-child { border-bottom: 0; }

        .contact-item-icon {
            width: 44px;
            height: 44px;
            flex: 0 0 auto;
            display: grid;
            place-items: center;
            color: var(--primary);
            border-radius: 14px;
            background: rgba(6, 182, 212, 0.08);
            border: 1px solid rgba(6, 182, 212, 0.15);
            font-size: 1.1rem;
        }

        .contact-item div strong { display: block; font-size: 0.84rem; margin-bottom: 2px; }
        .contact-item div span { color: var(--muted); font-size: 0.74rem; }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .contact-form textarea {
            width: 100%;
            min-height: 130px;
            resize: vertical;
            padding: 14px 16px;
            color: #ffffff;
            background: rgba(2, 6, 23, 0.6);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            transition: var(--transition);
            font-size: 0.9rem;
        }

        .contact-form textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--gradient-glow);
            background: rgba(2, 6, 23, 0.85);
        }

        .whatsapp-btn {
            width: 100%;
            color: #ffffff;
            background: #25d366;
            box-shadow: 0 10px 25px rgba(37, 211, 102, 0.2);
            height: 52px;
            border-radius: var(--radius-md);
            font-weight: 800;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: var(--transition);
        }

        .whatsapp-btn:hover {
            background: #20bd5b;
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(37, 211, 102, 0.35);
        }

        /* Footer */
        footer {
            width: min(1180px, 92%);
            margin: auto;
            padding: 35px 0 50px;
            border-top: 1px solid var(--border);
            text-align: center;
            color: #64748b;
            font-size: 0.8rem;
        }

        footer strong { color: var(--primary); }

        /* ==========================================================================
           6. المكونات الإضافية
           ========================================================================== */
        .theme-wrapper {
            position: fixed;
            bottom: 25px;
            left: 25px;
            z-index: 1500;
        }

        .theme-toggle {
            width: 52px;
            height: 52px;
            display: grid;
            place-items: center;
            color: #ffffff;
            border-radius: 50%;
            background: var(--gradient);
            box-shadow: 0 10px 30px var(--gradient-glow);
            transition: var(--transition);
            font-size: 1.2rem;
        }

        .theme-toggle:hover {
            transform: translateY(-4px) rotate(30deg);
            box-shadow: 0 15px 35px var(--gradient-glow);
        }

        .theme-panel {
            position: absolute;
            left: 0;
            bottom: 65px;
            width: 240px;
            padding: 16px;
            border: 1px solid var(--border);
            border-radius: 20px;
            background: rgba(3, 7, 18, 0.95);
            backdrop-filter: blur(25px);
            box-shadow: var(--shadow);
            opacity: 0;
            visibility: hidden;
            transform: translateY(15px) scale(0.95);
            transform-origin: bottom left;
            transition: var(--transition);
        }

        .theme-panel.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0) scale(1);
        }

        .theme-panel-title {
            margin-bottom: 12px;
            font-size: 0.8rem;
            color: #cbd5e1;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .theme-options {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
        }

        .theme-option {
            position: relative;
            width: 44px;
            height: 44px;
            border: 2px solid transparent;
            border-radius: 12px;
            transition: var(--transition);
        }

        .theme-option:hover { transform: translateY(-3px) scale(1.05); }
        .theme-option.active {
            border-color: #ffffff;
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.3);
        }

        .theme-option::after {
            content: "";
            position: absolute;
            inset: 4px;
            border-radius: 8px;
            background: var(--theme);
        }

        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            padding: 20px;
            opacity: 0;
            visibility: hidden;
            transition: var(--transition);
        }

        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal-content {
            background: rgba(15, 23, 42, 0.95);
            border: 1px solid var(--border);
            border-radius: 22px;
            padding: 30px;
            max-width: 420px;
            width: 100%;
            text-align: center;
            transform: scale(0.9);
            box-shadow: var(--shadow);
            transition: var(--transition);
        }

        .modal-overlay.active .modal-content { transform: scale(1); }

        .modal-buttons {
            display: flex;
            gap: 12px;
            margin-top: 22px;
        }

        .modal-btn {
            flex: 1;
            height: 46px;
            border-radius: var(--radius-sm);
            font-weight: 700;
            font-size: 0.9rem;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .toast {
            position: fixed;
            right: 50%;
            bottom: 25px;
            z-index: 999999;
            min-width: min(90%, 340px);
            padding: 13px 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            background: rgba(15, 23, 42, 0.95);
            backdrop-filter: blur(15px);
            color: #ffffff;
            font-size: 0.86rem;
            font-weight: 700;
            box-shadow: var(--shadow);
            transform: translate(50%, 90px);
            opacity: 0;
            pointer-events: none;
            transition: var(--transition);
        }

        .toast.show {
            transform: translate(50%, 0);
            opacity: 1;
        }

        .toast i { color: var(--primary); font-size: 1.1rem; }

        .back-to-top {
            position: fixed;
            bottom: 25px;
            right: 25px;
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: rgba(15, 23, 42, 0.85);
            border: 1px solid var(--border);
            color: #ffffff;
            display: grid;
            place-items: center;
            z-index: 990;
            opacity: 0;
            visibility: hidden;
            transform: translateY(20px);
            transition: var(--transition);
            box-shadow: var(--shadow);
        }

        .back-to-top.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .back-to-top:hover {
            background: var(--gradient);
            border-color: transparent;
            transform: translateY(-4px);
        }

        /* ==========================================================================
           7. Animations & Keyframes
           ========================================================================== */
        @keyframes loginAppear { from { opacity: 0; transform: translateY(25px) scale(0.96); } to { opacity: 1; transform: translateY(0) scale(1); } }
        @keyframes formFade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(5px); } 75% { transform: translateX(-5px); } }
        @keyframes floatLogo { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
        @keyframes gridMove { from { transform: translate(0, 0); } to { transform: translate(65px, 65px); } }
        @keyframes orbOne { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(-80px, 80px) scale(1.12); } }
        @keyframes orbTwo { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(90px, -60px) scale(1.15); } }
        @keyframes orbThree { 0%, 100% { transform: translate(0, 0); } 50% { transform: translate(60px, 60px); } }
        @keyframes rotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        @keyframes avatarFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }
        @keyframes tagFloat { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
        @keyframes pulse { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(0.75); opacity: 0.5; } }

        /* ==========================================================================
           8. Responsive Design & Media Queries
           ========================================================================== */
        @media (max-width: 1024px) {
            .hero-content { grid-template-columns: 1fr; gap: 45px; text-align: center; }
            .hero { padding-top: 140px; }
            .available-badge, .hero-description, .hero-actions { margin-right: auto; margin-left: auto; justify-content: center; }
            .skills-grid { grid-template-columns: repeat(2, 1fr); }
            .projects-grid { grid-template-columns: repeat(2, 1fr); }
            .social-grid { grid-template-columns: repeat(2, 1fr); }
            .contact-wrapper { grid-template-columns: 1fr; }
        }

        @media (max-width: 768px) {
            :root { --header-height: 68px; }
            .site-header { top: 10px; padding: 0 3%; }
            .desktop-nav { display: none; }
            .menu-toggle { display: grid; }
            section { padding: 75px 0; }
            .hero { padding-top: 120px; min-height: auto; }
            .hero-visual { min-height: 330px; }
            .hero-orbit { width: 280px; height: 280px; }
            .hero-avatar { width: 185px; height: 185px; }
            .avatar-initials { font-size: 3.2rem; }
            .projects-grid { grid-template-columns: 1fr; }
            .form-row { grid-template-columns: 1fr; }
        }

        @media (max-width: 480px) {
            .login-card { padding: 25px 20px; border-radius: 24px; }
            .skills-grid, .social-grid { grid-template-columns: 1fr 1fr; gap: 10px; }
            .skill-card { padding: 20px 14px; }
            .skill-icon { width: 50px; height: 50px; font-size: 1.3rem; margin-bottom: 12px; }
            .hero-actions { flex-direction: column; width: 100%; }
            .hero-actions .btn { width: 100%; }
            .theme-wrapper { bottom: 15px; left: 15px; }
            .back-to-top { bottom: 15px; right: 15px; width: 44px; height: 44px; }
        }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
            .grid-background, .orb, .hero-orbit, .hero-avatar, .floating-tag {
                animation: none !important;
            }
        }
    </style>
</head>


                    document.getElementById("passwordError").classList.add("show");
                    valid = false;
                }

                if (valid) {
                    setButtonLoading(this.querySelector(".login-btn"), true);
                    setTimeout(() => loginSuccessfully(), 700);
                }
            });

            const phoneForm = document.getElementById("phoneForm");
            const phoneInput = document.getElementById("phone");
            const otpBox = document.getElementById("otpBox");
            const otpInput = document.getElementById("otp");
            const phoneButton = document.getElementById("phoneButton");

            phoneInput.addEventListener("input", function () {
                this.value = this.value.replace(/\D/g, "").slice(0, 11);
                if (this.value.length === 11) document.getElementById("phoneError").classList.remove("show");
            });

            otpInput.addEventListener("input", function () {
                this.value = this.value.replace(/\D/g, "").slice(0, 6);
                if (this.value.length === 6) document.getElementById("otpError").classList.remove("show");
            });

            phoneForm.addEventListener("submit", function (e) {
                e.preventDefault();
                clearLoginErrors();
                const phone = phoneInput.value.trim();

                if (!otpBox.classList.contains("show")) {
                    if (!/^01[0125]\d{8}$/.test(phone)) {
                        document.getElementById("phoneError").classList.add("show");
                        return;
                    }
                    setButtonLoading(phoneButton, true);
                    setTimeout(() => {
                        setButtonLoading(phoneButton, false);
                        otpBox.classList.add("show");
                        phoneButton.innerHTML = '<i class="fa-solid fa-right-to-bracket"></i> <span>تأكيد الكود والدخول</span>';
                        showToast("تم إرسال كود التحقق التجريبي (أدخل أي 6 أرقام).");
                        otpInput.focus();
                    }, 600);
                    return;
                }

                if (!/^\d{6}$/.test(otpInput.value.trim())) {
                    document.getElementById("otpError").classList.add("show");
                    return;
                }

                setButtonLoading(phoneButton, true);
                setTimeout(() => loginSuccessfully(), 700);
            });
        }

        function setButtonLoading(button, isLoading) {
            if (isLoading) {
                button.dataset.original = button.innerHTML;
                button.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>جاري التحقق...</span>';
                button.disabled = true;
            } else {
                button.innerHTML = button.dataset.original || button.innerHTML;
                button.disabled = false;
            }
        }

        function loginSuccessfully() {
            localStorage.setItem("dahshan_logged_in", "true");
            const loginScreen = document.getElementById("loginScreen");
            const mainContent = document.getElementById("mainContent");

            loginScreen.style.opacity = "0";
            loginScreen.style.visibility = "hidden";

            setTimeout(() => {
                loginScreen.style.display = "none";
                mainContent.style.display = "block";
                setTimeout(() => mainContent.classList.add("visible"), 50);
                document.body.classList.remove("locked");
                window.scrollTo({ top: 0, behavior: "instant" });
                showToast("مرحباً بك في Portfolio عبدالرحمن دهشان.");
                initializeScrollObserver();
            }, 500);
        }

        function clearLoginErrors() {
            document.querySelectorAll(".error-message").forEach(error => error.classList.remove("show"));
        }

        /* ==========================================
           5. التنقل والتمرير
           ========================================== */
        function initializeNavigation() {
            const menuToggle = document.getElementById("menuToggle");
            const mobileNav = document.getElementById("mobileNav");
            const mobileClose = document.getElementById("mobileClose");
            const navOverlay = document.getElementById("navOverlay");
            const backToTop = document.getElementById("backToTop");

            function openMenu() {
                mobileNav.classList.add("active");
                navOverlay.classList.add("active");
                menuToggle.setAttribute("aria-expanded", "true");
                document.body.classList.add("locked");
            }

            window.closeMenu = function () {
                mobileNav.classList.remove("active");
                navOverlay.classList.remove("active");
                menuToggle.setAttribute("aria-expanded", "false");
                if (localStorage.getItem("dahshan_logged_in") === "true") {
                    document.body.classList.remove("locked");
                }
            };

            menuToggle.addEventListener("click", openMenu);
            mobileClose.addEventListener("click", window.closeMenu);
            navOverlay.addEventListener("click", window.closeMenu);
            document.querySelectorAll(".mobile-links a").forEach(link => link.addEventListener("click", window.closeMenu));

            document.addEventListener("keydown", e => {
                if (e.key === "Escape") {
                    window.closeMenu();
                    closeLogoutModal();
                    closeProjectModal();
                }
            });

            window.addEventListener("scroll", () => {
                if (window.scrollY > 400) {
                    backToTop.classList.add("active");
                } else {
                    backToTop.classList.remove("active");
                }
                updateActiveNavLink();
            });

            backToTop.addEventListener("click", () => {
                window.scrollTo({ top: 0, behavior: "smooth" });
            });
        }

        function updateActiveNavLink() {
            const sections = document.querySelectorAll("section[id]");
            const navLinks = document.querySelectorAll(".desktop-nav a");
            let current = "";

            sections.forEach(section => {
                const sectionTop = section.offsetTop - 150;
                if (window.scrollY >= sectionTop) {
                    current = section.getAttribute("id");
                }
            });

            navLinks.forEach(link => {
                link.classList.toggle("active", link.getAttribute("href") === `#${current}`);
            });
        }

        /* ==========================================
           6. ملء المهارات والمشاريع
           ========================================== */
        function renderSkillsAndProjects() {
            const skillsContainer = document.getElementById("skillsContainer");
            skillsContainer.innerHTML = skillsData.map(s => `
                <article class="skill-card reveal">
                    <div class="skill-icon"><i class="${s.icon}"></i></div>
                    <h3>${s.title}</h3>
                    <p>${s.desc}</p>
                </article>
            `).join("");

            const projectsContainer = document.getElementById("projectsContainer");
            projectsContainer.innerHTML = projectsData.map(p => `
                <article class="project-card reveal">
                    <div class="project-art"><div class="project-icon"><i class="${p.icon}"></i></div></div>
                    <div class="project-info">
                        <div class="project-tags">${p.tags.map(t => `<span class="project-tag">${t}</span>`).join("")}</div>
                        <h3>${p.title}</h3>
                        <p>${p.desc}</p>
                    </div>
                    <div class="project-overlay">
                        <button class="project-action" onclick="openProjectModal(${p.id})" title="تفاصيل المشروع" aria-label="تفاصيل المشروع">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                        <a href="${p.githubUrl}" target="_blank" rel="noopener noreferrer" class="project-action" title="الكود على GitHub" aria-label="GitHub">
                            <i class="fa-brands fa-github"></i>
                        </a>
                    </div>
                </article>
            `).join("");
        }

        /* ==========================================
           7. النوافذ المنبثقة للمشاريع
           ========================================== */
        window.openProjectModal = function(id) {
            const project = projectsData.find(p => p.id === id);
            if (!project) return;

            document.getElementById("projectModalTitle").textContent = project.title;
            document.getElementById("projectModalDesc").textContent = project.desc;
            document.getElementById("projectModalTags").innerHTML = project.tags.map(t => `<span class="project-tag">${t}</span>`).join("");
            document.getElementById("projectModalDemo").setAttribute("href", project.demoUrl);
            document.getElementById("projectModal").classList.add("active");
            document.body.classList.add("locked");
        };

        window.closeProjectModal = function() {
            document.getElementById("projectModal").classList.remove("active");
            if (localStorage.getItem("dahshan_logged_in") === "true") {
                document.body.classList.remove("locked");
            }
        };

        /* ==========================================
           8. مراقب التمرير والظهور
           ========================================== */
        function initializeScrollObserver() {
            const reveals = document.querySelectorAll(".reveal");
            const observer = new IntersectionObserver((entries, obs) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add("active");
                        obs.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.15 });

            reveals.forEach(el => observer.observe(el));
        }

        /* ==========================================
           9. نموذج التواصل المباشر (رقم الموبايل + WhatsApp)
           ========================================== */
        function initializeContactForm() {
            const contactPhoneInput = document.getElementById("contactPhone");
            
            // قصر الإدخال على الأرقام بحد أقصى 11 رقماً
            contactPhoneInput.addEventListener("input", function() {
                this.value = this.value.replace(/\D/g, "").slice(0, 11);
            });

            document.getElementById("contactForm").addEventListener("submit", function (e) {
                e.preventDefault();
                const name = document.getElementById("contactName").value.trim();
                const phone = document.getElementById("contactPhone").value.trim();
                const message = document.getElementById("contactMessage").value.trim();

                if (!name || !phone || !message) {
                    showToast("يرجى ملء جميع الحقول أولاً.");
                    return;
                }

                if (!/^01[0125]\d{8}$/.test(phone)) {
                    showToast("يرجى إدخال رقم موبايل صحيح (11 رقماً يبدأ بـ 01).");
                    return;
                }

                /* =========================================================================
                   ⚠️ رقم الواتساب: قم بتغيير هذا المتغير إلى رقم الواتساب الخاص بك
                   ملاحظة: بصيغة دولية بدون علامة + أو أصفار في البداية (مثال لمصر: 2010xxxxxxxx)
                   ========================================================================= */
                const YOUR_WHATSAPP_NUMBER = "201000000000";

                const text = `مرحباً عبدالرحمن 👋%0A%0A📌 الاسم: ${encodeURIComponent(name)}%0A📱 رقم الموبايل: ${encodeURIComponent(phone)}%0A%0A📝 تفاصيل الرسالة:%0A${encodeURIComponent(message)}`;
                
                window.open(`https://wa.me/${YOUR_WHATSAPP_NUMBER}?text=${text}`, "_blank", "noopener,noreferrer");
                this.reset();
                showToast("تم فتح تطبيق WhatsApp برقمك ورسالتك.");
            });
        }

        /* ==========================================
           10. الأدوات المساعدة والمودال
           ========================================== */
        let toastTimer = null;
        function showToast(message) {
            const toast = document.getElementById("toast");
            document.getElementById("toastMessage").textContent = message;
            toast.classList.add("show");
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.remove("show"), 3500);
        }

        window.showLogoutModal = function () {
            document.getElementById("logoutModal").classList.add("active");
            document.body.classList.add("locked");
        };

        window.closeLogoutModal = function () {
            document.getElementById("logoutModal").classList.remove("active");
            if (localStorage.getItem("dahshan_logged_in") === "true") {
                document.body.classList.remove("locked");
            }
        };

        window.confirmLogout = function () {
            localStorage.removeItem("dahshan_logged_in");
            location.reload();
        };

        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener("click", function (e) {
                const targetId = this.getAttribute("href");
                if (targetId === "#") return;
                const target = document.querySelector(targetId);
                if (target) {
                    e.preventDefault();
                    target.scrollIntoView({ behavior: "smooth", block: "start" });
                }
            });
        });

        /* ==========================================
           11. نقطة البداية
           ========================================== */
        document.addEventListener("DOMContentLoaded", function () {
            initializeTheme();
            initializeCanvasParticles();
            checkLoginState();
            initializeLogin();
            initializeNavigation();
            initializeThemePicker();
            renderSkillsAndProjects();
            initializeScrollObserver();
            initializeContactForm();
            document.getElementById("year").textContent = new Date().getFullYear();
        });
    </script>
</body>
</html>

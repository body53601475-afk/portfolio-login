    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        /* ==========================================================================
           1. نظام المتغيرات والتصميم الجذري (CSS Variables & Global Reset)
           ========================================================================== */
        :root {
            --primary: #06b6d4;
            --secondary: #0891b2;
            --accent: #22d3ee;
            --dark: #020617;
            --dark-elevated: rgba(15, 23, 42, 0.75);
            --card-bg: rgba(15, 23, 42, 0.65);
            --text: #f8fafc;
            --muted: #94a3b8;
            --border: rgba(255, 255, 255, 0.08);
            --border-hover: rgba(6, 182, 212, 0.4);
            --gradient: linear-gradient(135deg, #06b6d4, #0891b2);
            --gradient-glow: rgba(6, 182, 212, 0.25);
            --shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
            --radius-lg: 24px;
            --radius-md: 16px;
            --radius-sm: 10px;
            --header-height: 78px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 105px;
        }

        body {
            font-family: "Cairo", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--dark);
            color: var(--text);
            overflow-x: hidden;
            min-height: 100vh;
            line-height: 1.65;
            transition: background-color 0.4s ease, color 0.3s ease;
        }

        body.locked {
            overflow: hidden;
            height: 100vh;
        }

        a {
            color: inherit;
            text-decoration: none;
            display: inline-block;
        }

        button, input, textarea {
            font-family: inherit;
            border: 0;
            outline: none;
            background: none;
        }

        button { cursor: pointer; }

        ::selection {
            background: var(--primary);
            color: #ffffff;
        }

        /* شريط التمرير */
        ::-webkit-scrollbar { width: 9px; }
        ::-webkit-scrollbar-track { background: var(--dark); }
        ::-webkit-scrollbar-thumb {
            background: var(--gradient);
            border-radius: 50px;
            border: 2px solid var(--dark);
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--accent);
        }

        a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: 3px;
        }

        /* ==========================================================================
           2. الخلفية الحية التفاعلية
           ========================================================================== */
        .background {
            position: fixed;
            inset: 0;
            z-index: -10;
            overflow: hidden;
            background: var(--dark);
            pointer-events: none;
        }

        .grid-background {
            position: absolute;
            inset: -100%;
            opacity: 0.12;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.08) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
            background-size: 65px 65px;
            animation: gridMove 30s linear infinite;
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            opacity: 0.22;
            background: var(--primary);
            will-change: transform;
            transition: background 0.4s ease;
        }

        .orb-1 { width: 340px; height: 340px; top: -80px; right: 8%; animation: orbOne 18s ease-in-out infinite; }
        .orb-2 { width: 300px; height: 300px; bottom: 5%; left: 8%; animation: orbTwo 22s ease-in-out infinite; }
        .orb-3 { width: 230px; height: 230px; top: 45%; left: 35%; opacity: 0.14; animation: orbThree 20s ease-in-out infinite; }

        #particleCanvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        /* ==========================================================================
           3. شاشة تسجيل الدخول التجريبية
           ========================================================================== */
        #loginScreen {
            position: fixed;
            inset: 0;
            z-index: 99999;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: radial-gradient(circle at 50% 30%, var(--gradient-glow), transparent 60%), #020617;
            transition: opacity 0.5s ease, visibility 0.5s ease;
        }

        .login-card {
            width: min(100%, 470px);
            position: relative;
            padding: 38px 30px;
            border: 1px solid var(--border);
            border-radius: 28px;
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            box-shadow: var(--shadow), 0 0 70px var(--gradient-glow);
            animation: loginAppear 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .login-card::before {
            content: "";
            position: absolute;
            inset: 0 0 auto;
            height: 3px;
            background: var(--gradient);
            border-radius: 28px 28px 0 0;
        }

        .login-logo {
            width: 78px;
            height: 78px;
            margin: 0 auto 16px;
            display: grid;
            place-items: center;
            border-radius: 22px;
            background: var(--gradient);
            color: #ffffff;
            font-size: 1.9rem;
            box-shadow: 0 10px 30px var(--gradient-glow);
            animation: floatLogo 4s ease-in-out infinite;
        }

        .login-title {
            text-align: center;
            font-size: 1.75rem;
            font-weight: 900;
            margin-bottom: 4px;
            letter-spacing: -0.5px;
        }

        .login-subtitle {
            color: var(--muted);
            text-align: center;
            margin-bottom: 24px;
            font-size: 0.88rem;
        }

        .login-tabs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
            padding: 5px;
            margin-bottom: 22px;
            border-radius: var(--radius-md);
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--border);
        }

        .login-tab {
            padding: 11px;
            border-radius: var(--radius-sm);
            color: var(--muted);
            background: transparent;
            transition: var(--transition);
            font-weight: 700;
            font-size: 0.86rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .login-tab.active {
            color: #ffffff;
            background: var(--gradient);
            box-shadow: 0 4px 20px var(--gradient-glow);
        }

        .login-form { display: none; }
        .login-form.active {
            display: block;
            animation: formFade 0.4s ease forwards;
        }

        .field {
            position: relative;
            margin-bottom: 16px;
        }

        .field label {
            display: block;
            margin-bottom: 7px;
            color: #e2e8f0;
            font-size: 0.84rem;
            font-weight: 700;
        }

        .input-wrap { position: relative; }
        .input-wrap > i {
            position: absolute;
            top: 50%;
            right: 16px;
            transform: translateY(-50%);
            color: var(--primary);
            pointer-events: none;
            transition: var(--transition);
        }

        .field input, .field textarea {
            width: 100%;
            height: 50px;
            padding: 0 46px 0 16px;
            color: #ffffff;
            background: rgba(2, 6, 23, 0.65);
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            font-size: 0.9rem;
            transition: var(--transition);
        }

        .field input:focus, .field textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--gradient-glow);
            background: rgba(2, 6, 23, 0.85);
        }

        .field input::placeholder, .field textarea::placeholder { color: #64748b; }

        .error-message {
            display: none;
            margin-top: 6px;
            color: #fb7185;
            font-size: 0.76rem;
            font-weight: 600;
        }

        .error-message.show {
            display: block;
            animation: shake 0.35s ease;
        }

        .otp-box { display: none; }
        .otp-box.show {
            display: block;
            animation: formFade 0.4s ease forwards;
        }

        .otp-input {
            direction: ltr;
            text-align: center;
            letter-spacing: 9px;
            font-size: 1.25rem !important;
            font-weight: 800;
        }

        .login-btn {
            width: 100%;
            height: 52px;
            margin-top: 8px;
            border-radius: var(--radius-md);
            color: #ffffff;
            background: var(--gradient);
            font-weight: 800;
            font-size: 0.96rem;
            box-shadow: 0 10px 25px var(--gradient-glow);
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .login-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px var(--gradient-glow);
        }

        .login-note {
            margin-top: 18px;
            color: #64748b;
            font-size: 0.74rem;
            text-align: center;
            line-height: 1.5;
        }

        /* ==========================================================================
           4. الهيدر والتنقل
           ========================================================================== */
        #mainContent {
            display: none;
            opacity: 0;
            transition: opacity 0.5s ease;
        }

        #mainContent.visible {
            display: block;
            opacity: 1;
        }

        .site-header {
            position: fixed;
            top: 15px;
            right: 0;
            left: 0;
            z-index: 1000;
            padding: 0 4%;
            transition: transform 0.3s ease;
        }

        .header-inner {
            height: var(--header-height);
            max-width: 1240px;
            margin: auto;
            padding: 0 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            background: rgba(2, 6, 23, 0.72);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.3);
            transition: var(--transition);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 900;
            font-size: 1.15rem;
        }

        .brand-icon {
            width: 42px;
            height: 42px;
            display: grid;
            place-items: center;
            border-radius: 13px;
            background: var(--gradient);
            color: #ffffff;
            font-size: 1rem;
            box-shadow: 0 0 20px var(--gradient-glow);
        }

        .desktop-nav {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .desktop-nav a {
            padding: 9px 15px;
            color: #cbd5e1;
            font-size: 0.88rem;
            font-weight: 700;
            border-radius: var(--radius-sm);
            transition: var(--transition);
            position: relative;
        }

        .desktop-nav a:hover, .desktop-nav a.active {
            color: #ffffff;
            background: rgba(255, 255, 255, 0.05);
        }

        .desktop-nav a.active::after {
            content: "";
            position: absolute;
            bottom: 3px;
            right: 15px;
            left: 15px;
            height: 2px;
            background: var(--primary);
            border-radius: 50px;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logout-btn-header {
            padding: 8px 16px;
            border-radius: 50px;
            background: rgba(239, 68, 68, 0.12);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.28);
            font-weight: 700;
            font-size: 0.84rem;
            transition: var(--transition);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .logout-btn-header:hover {
            background: #ef4444;
            color: #ffffff;
            box-shadow: 0 0 20px rgba(239, 68, 68, 0.4);
            transform: translateY(-2px);
        }

        .menu-toggle {
            width: 44px;
            height: 44px;
            display: none;
            place-items: center;
            color: #ffffff;
            border-radius: var(--radius-sm);
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border);
            font-size: 1.15rem;
            transition: var(--transition);
        }

        .menu-toggle:hover { background: rgba(255, 255, 255, 0.1); }

        /* Mobile Drawer */
        .nav-overlay {
            position: fixed;
            inset: 0;
            z-index: 1998;
            background: rgba(0, 0, 0, 0.7);
            backdrop-filter: blur(8px);
            opacity: 0;
            visibility: hidden;
            transition: var(--transition);
        }

        .nav-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .mobile-nav {
            position: fixed;
            top: 0;
            right: -100%;
            bottom: 0;
            z-index: 1999;
            width: min(85%, 350px);
            padding: 25px;
            display: flex;
            flex-direction: column;
            background: rgba(3, 7, 18, 0.96);
            backdrop-filter: blur(25px);
            border-left: 1px solid var(--border);
            transition: right 0.45s cubic-bezier(0.77, 0, 0.18, 1);
        }

        .mobile-nav.active { right: 0; }

        .mobile-nav-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding-bottom: 20px;
            margin-bottom: 20px;
            border-bottom: 1px solid var(--border);
        }

        .mobile-nav-title {
            font-weight: 900;
            font-size: 1.1rem;
        }

        .mobile-close {
            width: 40px;
            height: 40px;
            display: grid;
            place-items: center;
            border-radius: var(--radius-sm);
            color: #ffffff;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid var(--border);
            transition: var(--transition);
        }

        .mobile-close:hover {
            transform: rotate(90deg);
            background: var(--gradient);
        }

        .mobile-links {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .mobile-links a {
            padding: 14px 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            color: #cbd5e1;
            font-weight: 700;
            font-size: 0.92rem;
            border-radius: var(--radius-md);
            opacity: 0;
            transform: translateX(30px);
            transition: var(--transition);
        }

        .mobile-nav.active .mobile-links a {
            opacity: 1;
            transform: translateX(0);
        }

        .mobile-nav.active .mobile-links a:nth-child(1) { transition-delay: 0.08s; }
        .mobile-nav.active .mobile-links a:nth-child(2) { transition-delay: 0.14s; }
        .mobile-nav.active .mobile-links a:nth-child(3) { transition-delay: 0.20s; }
        .mobile-nav.active .mobile-links a:nth-child(4) { transition-delay: 0.26s; }
        .mobile-nav.active .mobile-links a:nth-child(5) { transition-delay: 0.32s; }

        .mobile-links a:hover, .mobile-links a.active {
            color: #ffffff;
            background: rgba(6, 182, 212, 0.12);
            border-right: 3px solid var(--primary);
        }

        .mobile-links i {
            width: 22px;
            color: var(--primary);
        }

        /* ==========================================================================
           5. الأقسام والمحتوى الرئيسي
           ========================================================================== */
        main { position: relative; z-index: 1; }

        section {
            width: min(1180px, 92%);
            margin: 0 auto;
            padding: 95px 0;
        }

        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.7s cubic-bezier(0.2, 0.8, 0.2, 1), transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
            will-change: opacity, transform;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        .section-heading {
            margin-bottom: 50px;
            text-align: center;
        }

        .section-kicker {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
            padding: 6px 14px;
            color: var(--primary);
            border: 1px solid rgba(6, 182, 212, 0.25);
            border-radius: 50px;
            background: rgba(6, 182, 212, 0.08);
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .section-heading h2 {
            font-size: clamp(1.85rem, 4vw, 2.7rem);
            font-weight: 900;
            line-height: 1.25;
        }

        .section-heading p {
            max-width: 620px;
            margin: 10px auto 0;
            color: var(--muted);
            font-size: 0.92rem;
            line-height: 1.8;
        }

        /* Hero */
        .hero {
            min-height: 100vh;
            padding-top: 155px;
            padding-bottom: 70px;
            display: flex;
            align-items: center;
        }

        .hero-content {
            width: 100%;
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            align-items: center;
            gap: 60px;
        }

        .available-badge {
            width: fit-content;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 22px;
            padding: 7px 16px;
            color: #86efac;
            border: 1px solid rgba(34, 197, 94, 0.3);
            background: rgba(34, 197, 94, 0.08);
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 800;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #22c55e;
            box-shadow: 0 0 12px #22c55e;
            animation: pulse 1.6s infinite;
        }

        .hero h1 {
            font-size: clamp(2.3rem, 5.5vw, 4.8rem);
            line-height: 1.12;
            font-weight: 900;
            letter-spacing: -1.5px;
            margin-bottom: 18px;
        }

        .gradient-text {
            display: inline-block;
            background: var(--gradient);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .hero-description {
            max-width: 650px;
            color: #94a3b8;
            line-height: 1.95;
            font-size: 1.05rem;
            margin-bottom: 30px;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 14px;
        }

        .btn {
            min-height: 52px;
            padding: 0 24px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            border-radius: var(--radius-md);
            font-weight: 800;
            font-size: 0.92rem;
            transition: var(--transition);
        }

        .btn-primary {
            color: #ffffff;
            background: var(--gradient);
            box-shadow: 0 10px 25px var(--gradient-glow);
        }

        .btn-primary:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 35px var(--gradient-glow);
        }

        .btn-secondary {
            color: #ffffff;
            border: 1px solid var(--border);
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(10px);
        }

        .btn-secondary:hover {
            background: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.2);
            transform: translateY(-4px);
        }

        .hero-visual {
            position: relative;
            min-height: 440px;
            display: grid;
            place-items: center;
        }

        .hero-orbit {
            position: absolute;
            width: 350px;
            height: 350px;
            border: 1px dashed rgba(6, 182, 212, 0.28);
            border-radius: 50%;
            animation: rotate 24s linear infinite;
        }

        .hero-orbit::before, .hero-orbit::after {
            content: "";
            position: absolute;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: var(--primary);
            box-shadow: 0 0 20px var(--primary);
        }

        .hero-orbit::before { top: 25px; left: 50px; }
        .hero-orbit::after { right: 35px; bottom: 60px; }

        .hero-avatar {
            position: relative;
            width: 220px;
            height: 220px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(6, 182, 212, 0.35);
            border-radius: 50%;
            background: radial-gradient(circle at 50% 35%, rgba(6, 182, 212, 0.25), transparent 60%), rgba(15, 23, 42, 0.85);
            box-shadow: 0 0 0 22px rgba(6, 182, 212, 0.04), var(--shadow);
            animation: avatarFloat 5s ease-in-out infinite;
        }

        .avatar-initials {
            font-size: 4rem;
            font-weight: 900;
            background: var(--gradient);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .floating-tag {
            position: absolute;
            padding: 10px 16px;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            background: rgba(15, 23, 42, 0.82);
            backdrop-filter: blur(15px);
            box-shadow: 0 15px 30px rgba(0, 0, 0, 0.3);
            color: #dbeafe;
            font-size: 0.76rem;
            font-weight: 800;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .tag-one { top: 45px; right: 10px; animation: tagFloat 4.2s ease-in-out infinite; }
        .tag-two { bottom: 50px; left: -10px; animation: tagFloat 4.8s 0.4s ease-in-out infinite; }

        /* Skills */
        .skills-grid {

        .project-icon {
            position: relative;
            z-index: 1;
            width: 86px;
            height: 86px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(6, 182, 212, 0.25);
            border-radius: 24px;
            color: var(--primary);
            background: rgba(2, 6, 23, 0.6);
            font-size: 2rem;
            transition: var(--transition);
